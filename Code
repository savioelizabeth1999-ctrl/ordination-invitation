<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ordination Invitation - Dn. Chettukadavil Savio VC</title>
  <style>
    :root {
      --primary-color: #8b0000;
      --gold-accent: #d4af37;
      --bg-dark: #121212;
      --card-bg: #1e1e1e;
      --text-light: #f5f5f5;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Georgia', serif;
      background-color: var(--bg-dark);
      color: var(--text-light);
      text-align: center;
      line-height: 1.6;
    }

    header {
      padding: 50px 20px;
      background: linear-gradient(130deg, #2c0000, #121212);
      border-bottom: 2px solid var(--gold-accent);
    }

    h1 {
      color: var(--gold-accent);
      font-size: 2.2rem;
      margin-bottom: 10px;
    }

    .subtitle {
      font-size: 1.2rem;
      font-style: italic;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--gold-accent);
      border-radius: 12px;
      padding: 30px;
      margin: 30px 0;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }

    .profile-img {
      width: 180px;
      height: 180px;
      object-fit: cover;
      border-radius: 50%;
      border: 3px solid var(--gold-accent);
      margin-bottom: 15px;
    }

    .bishop-img {
      width: 140px;
      height: 140px;
      object-fit: cover;
      border-radius: 50%;
      border: 2px solid var(--gold-accent);
      margin-bottom: 10px;
    }

    .details-table {
      width: 100%;
      margin-top: 20px;
      border-collapse: collapse;
    }

    .details-table td {
      padding: 12px;
      border-bottom: 1px solid #333;
    }

    .details-table td:first-child {
      font-weight: bold;
      color: var(--gold-accent);
      text-align: right;
      width: 40%;
    }

    .details-table td:last-child {
      text-align: left;
    }

    .btn {
      display: inline-block;
      background-color: var(--primary-color);
      color: var(--gold-accent);
      padding: 12px 24px;
      text-decoration: none;
      border: 1px solid var(--gold-accent);
      border-radius: 6px;
      margin-top: 15px;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn:hover {
      background-color: var(--gold-accent);
      color: var(--bg-dark);
    }

    .route-section {
      text-align: left;
      margin-top: 15px;
    }

    .route-section h4 {
      color: var(--gold-accent);
      margin-bottom: 5px;
    }

    footer {
      padding: 30px;
      font-size: 0.9rem;
      border-top: 1px solid #333;
      color: #888;
    }
  </style>
</head>
<body>

  <header>
    <h1>Sacerdotal Ordination</h1>
    <p class="subtitle">"Called to Serve in His Love"</p>
  </header>

  <div class="container">
    <!-- Ordinand Section -->
    <div class="card">
      <!-- YOUR PHOTO FILENAME -->
      <img src="Savio.jpg" alt="Dn. Chettukadavil Savio VC" class="profile-img">
      <h2>Dn. Chettukadavil Savio VC</h2>
      <p style="color: var(--gold-accent);">To be Ordained Priest</p>
    </div>

    <!-- Ordaining Prelate Section -->
    <div class="card">
      <!-- BISHOP PHOTO FILENAME -->
      <img src="Bishop.png" alt="Bp. Sebastian Adayanthrath" class="bishop-img">
      <h3>Bp. Sebastian Adayanthrath</h3>
      <p>Bishop of the Diocese of Mandya</p>
      <p style="font-size: 0.9rem; color: #aaa;">Ordaining Prelate</p>
    </div>

    <!-- Event Details -->
    <div class="card">
      <h3 style="color: var(--gold-accent); margin-bottom: 15px;">Program Details</h3>
      <table class="details-table">
        <tr>
          <td>Date:</td>
          <td>Saturday, 8th May 2027</td>
        </tr>
        <tr>
          <td>Venue:</td>
          <td>De Paul Divine Retreat Centre, Thottakom, Vaikom</td>
        </tr>
      </table>

      <a href="https://maps.app.goo.gl/5Rj2ycVFpeCNK8Kt7" target="_blank" class="btn">📍 Open Venue in Google Maps</a>
    </div>

    <!-- Route Map Info -->
    <div class="card">
      <h3 style="color: var(--gold-accent); margin-bottom: 15px;">Route Directions</h3>
      
      <div class="route-section">
